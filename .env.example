# Application Settings
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=change_this_to_a_secure_secret_use_crypto.randomBytes
SESSION_SECRET=change_this_to_a_different_secure_secret
AUTH_TOKEN_EXPIRY=1d

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/homelab
MONGO_USERNAME=your_mongodb_username
MONGO_PASSWORD=your_mongodb_password

# SSL Configuration
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# Security Settings (Optional)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Docker Platform - uncomment appropriate line for your architecture
#DOCKER_PLATFORM=linux/amd64
#DOCKER_PLATFORM=linux/arm64

# MongoDB Image - uncomment appropriate line based on your ARM architecture
#MONGO_IMAGE=mongo:7.0    # For ARMv8.2-A or higher (most modern ARM64 systems)
#MONGO_IMAGE=mongo:4.4.18 # For older ARM systems without ARMv8.2-A support

# Generate secure secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"